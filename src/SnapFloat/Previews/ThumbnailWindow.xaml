<Window x:Class="SnapFloat.Previews.ThumbnailWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SnapFloat.Views"
        Title="SnapFloat screenshot preview"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Font.UI}" FontSize="{StaticResource Font.Body}"
        AutomationProperties.Name="Screenshot preview. Drag to drop the image file into another app.">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.ToolbarText}" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.ToolbarText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{DynamicResource Brush.Toolbar}" Stroke="{DynamicResource Brush.ToolbarBorder}" StrokeThickness="1" />
                            <v:IconView Geometry="{StaticResource Icon.Close}" Size="12" Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource Brush.Surface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="RootShift" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow is drawn by a sibling so the screenshot itself is never rasterised through an effect. -->
        <Border x:Name="ShadowHost" Background="{DynamicResource Brush.Surface}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect x:Name="Shadow" BlurRadius="22" ShadowDepth="5" Direction="270"
                                  Color="{DynamicResource Shadow.Color}" Opacity="{DynamicResource Shadow.Opacity}" RenderingBias="Quality" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Card" Background="{DynamicResource Brush.Surface}" Cursor="Hand">
            <Image x:Name="Picture" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />

            <!-- Pinned badge -->
            <Border x:Name="PinBadge" Width="24" Height="24" CornerRadius="12" Margin="0,7,7,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.ToolbarBorder}" BorderThickness="1"
                    ToolTip="Pinned. Stays until you close it." AutomationProperties.Name="Pinned">
                <v:IconView Geometry="{StaticResource Icon.Pin}" Size="13" FillGeometry="True" Foreground="{DynamicResource Brush.AccentForeground}" />
            </Border>

            <!-- Quick actions -->
            <Border x:Name="Toolbar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                    CornerRadius="9" Padding="3" Visibility="Collapsed" Opacity="0"
                    Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.ToolbarBorder}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToolbarShift" Y="0" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CopyImageButton" Style="{StaticResource ToolbarButton}" Click="OnCopyImage"
                            ToolTip="Copy image" AutomationProperties.Name="Copy image">
                        <v:IconView Geometry="{StaticResource Icon.Copy}" />
                    </Button>
                    <Button x:Name="CopyPathButton" Style="{StaticResource ToolbarButton}" Click="OnCopyPath"
                            ToolTip="Copy file path" AutomationProperties.Name="Copy file path">
                        <v:IconView Geometry="{StaticResource Icon.Link}" />
                    </Button>
                    <Button x:Name="OpenButton" Style="{StaticResource ToolbarButton}" Click="OnOpen"
                            ToolTip="Open" AutomationProperties.Name="Open screenshot">
                        <v:IconView Geometry="{StaticResource Icon.Open}" />
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource ToolbarButton}" Click="OnTogglePin"
                            ToolTip="Pin" AutomationProperties.Name="Pin screenshot">
                        <v:IconView x:Name="PinIcon" Geometry="{StaticResource Icon.Pin}" />
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource ToolbarButton}" Click="OnDelete"
                            ToolTip="Move to Recycle Bin" AutomationProperties.Name="Delete screenshot">
                        <v:IconView Geometry="{StaticResource Icon.Trash}" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Transient status ("Copied", errors). Always icon + text. -->
            <Border x:Name="StatusPill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,8,8,0"
                    CornerRadius="9" Padding="9,4,11,4" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.ToolbarBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <v:IconView x:Name="StatusIcon" Geometry="{StaticResource Icon.Check}" Size="14" Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock x:Name="StatusText" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Font.Caption}"
                               Foreground="{DynamicResource Brush.ToolbarText}" Text="Copied" />
                </StackPanel>
            </Border>

            <!-- Error state (capture/save failed) -->
            <Grid x:Name="ErrorPanel" Visibility="Collapsed" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.DangerSubtle}" VerticalAlignment="Top">
                    <v:IconView Geometry="{StaticResource Icon.Alert}" Size="18" Foreground="{DynamicResource Brush.Danger}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ErrorTitle" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Couldn't save screenshot" />
                    <TextBlock x:Name="ErrorDetail" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Hairline outline drawn above the image so edges stay crisp on any background. -->
        <Border x:Name="Outline" BorderThickness="1" BorderBrush="{DynamicResource Brush.ThumbBorder}" IsHitTestVisible="False" />

        <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Click="OnClose" Opacity="0" Visibility="Hidden"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9,-9,0,0"
                ToolTip="Close preview" AutomationProperties.Name="Close preview" />
    </Grid>
</Window>
