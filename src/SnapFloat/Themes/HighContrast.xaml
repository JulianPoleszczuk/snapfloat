<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows high-contrast mode: every brush maps to a system colour chosen by the user. -->
    <SolidColorBrush x:Key="Brush.Window" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{x:Static SystemColors.HighlightColor}" Opacity="0.35" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{x:Static SystemColors.HighlightColor}" Opacity="0.55" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.ToggleOff" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.ThumbBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Toolbar" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.ToolbarBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.ToolbarText" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.MenuBackground" Color="{x:Static SystemColors.MenuColor}" />
    <Color x:Key="Shadow.Color">#000000</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Shadow.Opacity">0</sys:Double>
</ResourceDictionary>
